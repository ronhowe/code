{
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "ApplicationInsights": "",
    "MyAzureStorage": "UseDevelopmentStorage=true;",
    "MyDatabase": "Server=localhost;Database=MyDatabase;Integrated Security=True;Application Name=MyWebApplication10 (Development);Encrypt=False;Connect Timeout=1;Command Timeout=0;"
  },
  "FeatureManagement": {
    "MyFeature": "false"
  },
  "Jwt": {
    "Issuer": "myIssuer",
    "Audience": "myAudience",
    "Key": "thisisaverylongsecretkeythatneedstobeatlesat32byteslong1234567890"
  },
  "RetrySettings": {
    "MaxRetries": 3,
    "RetryMilliseconds": 1000
  },
  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "MyConfiguration": "MyWebApplication10 (Development)",
  "MyHeader": "MyHeader (Development)",
  "Serilog": {
    "Enrich": [
      "FromLogContext",
      "WithMachineName"
    ],
    "MinimumLevel": {
      "Default": "Warning",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "MyWebApplication10": "Debug",
        "MyClassLibrary10.MyRepository": "Debug",
        "MyClassLibrary10.MyService": "Debug"
      }
    },
    "Properties": {
      "Application": "MyWebApplication10 (Development)"
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{UtcTimestamp:yyyy-MM-dd HH:mm:ss.fff}] [{Level:u3}] [{SourceContext}] {Message}{NewLine}{Exception}"
        }
      }
    ]
  }
}

