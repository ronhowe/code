{
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "ApplicationInsights": "",
    "MyAzureStorage": "https://stronhowe0.table.core.windows.net/",
    "MyDatabase": "Server=tcp:sql-ronhowe-0.database.windows.net,1433;Initial Catalog=sqldb-ronhowe-0;Encrypt=True;TrustServerCertificate=False;Connection Timeout=30;Authentication=Active Directory Default;"
  },
  "FeatureManagement": {
    "MyFeature": "false"
  },
  "Jwt": {
    "Issuer": "myIssuer",
    "Audience": "myAudience",
    "Key": "thisisaverylongsecretkeythatneedstobeatlesat32byteslong1234567890"
  },
  "RetrySettings": {
    "MaxRetries": 3,
    "RetryMilliseconds": 1000
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "MyConfiguration": "MyWebApplication10 (Production)",
  "MyHeader": "MyHeader (Production)",
  "Serilog": {
    "Enrich": [
      "FromLogContext",
      "WithMachineName"
    ],
    "MinimumLevel": {
      "Default": "Warning",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "MyWebApplication10": "Information",
        "MyClassLibrary10.MyRepository": "Information",
        "MyClassLibrary10.MyService": "Information"
      }
    },
    "Properties": {
      "Application": "MyWebApplication10 (Production)"
    },
    "WriteTo": [
      {
        "Name": "ApplicationInsights",
        "Args": {
          "connectionString": "",
          "telemetryConverter": "Serilog.Sinks.ApplicationInsights.TelemetryConverters.TraceTelemetryConverter, Serilog.Sinks.ApplicationInsights"
        }
      },
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{UtcTimestamp:yyyy-MM-dd HH:mm:ss.fff}] [{Level:u3}] [{MachineName}] [{SourceContext}] {Message}{NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "D:\\home\\LogFiles\\MyLogs\\MyWebApplication10-Production-.txt",
          "rollingInterval": "Day",
          "fileSizeLimitBytes": 52428800,
          "rollOnFileSizeLimit": true,
          "outputTemplate": "[{UtcTimestamp:yyyy-MM-dd HH:mm:ss.fff}] [{Level:u3}] [{MachineName}] [{SourceContext}] {Message}{NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "D:\\home\\LogFiles\\MyLogs\\MyWebApplication10-Production-.json",
          "formatter": "Serilog.Formatting.Json.JsonFormatter, Serilog",
          "rollingInterval": "Day",
          "fileSizeLimitBytes": 52428800,
          "rollOnFileSizeLimit": true
        }
      }
    ]
  }
}
